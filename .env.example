# LiveKit Configuration
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
LIVEKIT_URL=wss://your-project.livekit.cloud

# Whisper model (read by the worker at startup)
MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Set true to run Direct mode only, without joining LiveKit rooms.
# Required if LiveKit credentials are absent, or the worker exits at boot.
DISABLE_AGENT_BOT=false

# --- Server ---
PORT=8080
WORKER_URL=http://localhost:8000

# Comma-separated origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Shared secret required by GET /token. Leave unset for local development;
# SET THIS before exposing the server beyond localhost, or anyone who can
# reach it can mint LiveKit credentials billed to your account.
# TOKEN_API_KEY=choose_a_long_random_string
TOKEN_TTL=15m
